*.py[cod]
*$py.class

# Virtual environments and local environment variables
.venv/
venv/
ENV/
.env
.env.*
!.env.example

# Test, type-checker, linter, and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build and package output
build/
dist/
*.egg-info/

# Local editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

